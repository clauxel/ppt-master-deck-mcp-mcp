{
  "name": "pptmasterdeck",
  "title": "PPT Master Deck MCP",
  "description": "A paid remote MCP for ppt-master, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://pptmasterdeck.clauxel.com/",
  "documentationUrl": "https://pptmasterdeck.clauxel.com/mcp/",
  "endpointUrl": "https://pptmasterdeck.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://pptmasterdeck.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://pptmasterdeck.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://pptmasterdeck.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "solo",
        "name": "Solo",
        "monthlyUsd": 29
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 89
      },
      {
        "id": "agency",
        "name": "Agency",
        "monthlyUsd": 229
      }
    ]
  },
  "tools": [
    {
      "name": "generate_editable_deck",
      "description": "PPT Master Deck MCP generate editable deck",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "string",
            "description": "Workflow sample, schema, policy fixture, or agent output."
          },
          "context": {
            "type": "string",
            "description": "Optional review context."
          }
        },
        "required": [
          "sample"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          },
          "usage_units": {
            "type": "integer"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
